# Database Connection (PostgreSQL or MySQL)
# Leave empty to use embedded local database with zero configuration.

# Option 1: PostgreSQL (e.g. Neon, Supabase, Vercel Postgres, or Local PostgreSQL)
# DATABASE_URL="postgres://username:password@ep-cool-forest-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Option 2: MySQL (e.g. PlanetScale, Railway, Aiven, or Local MySQL)
# DATABASE_URL="mysql://username:password@localhost:3306/courseconnect"

# Node Environment
NODE_ENV=development
